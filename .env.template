FUNCTION_NAME=admin-service
NODE_ENV=dev
MAX_CPU=1

# FASTIFY
PORT=3100
HOST='0.0.0.0'

# DATABASE
CONFIGURATION_DATABASE_PORT='5432'
#CONFIGURATION_DATABASE_CERT_PATH=''
CONFIGURATION_DATABASE='configuration'
CONFIGURATION_DATABASE_USER='postgres'
CONFIGURATION_DATABASE_PASSWORD='password'
CONFIGURATION_DATABASE_HOST='localhost'

EVENT_HISTORY_DATABASE_PORT='5432'
EVENT_HISTORY_DATABASE='event_history'
#EVENT_HISTORY_DATABASE_CERT_PATH=''
EVENT_HISTORY_DATABASE_USER='postgres'
EVENT_HISTORY_DATABASE_PASSWORD='password'
EVENT_HISTORY_DATABASE_HOST='localhost'

# simulation
SIMULATION_DATABASE_PORT='5432'
SIMULATION_DATABASE='simulation'
SIMULATION_DATABASE_USER='postgres'
SIMULATION_DATABASE_PASSWORD='password'
SIMULATION_DATABASE_HOST='localhost'

EVALUATION_DATABASE_PORT='5432'
EVALUATION_DATABASE='event_history'
#EVALUATION_DATABASE_CERT_PATH=''
EVALUATION_DATABASE_USER='postgres'
EVALUATION_DATABASE_PASSWORD='password'
EVALUATION_DATABASE_HOST='localhost'

RAW_HISTORY_DATABASE_PORT='5432'
RAW_HISTORY_DATABASE='raw_history'
#RAW_HISTORY_DATABASE_CERT_PATH=''
RAW_HISTORY_DATABASE_USER='postgres'
RAW_HISTORY_DATABASE_PASSWORD='password'
RAW_HISTORY_DATABASE_HOST='localhost'

# QUERY-NODE READ-ONLY ROLE (per database)
# Read-only DB role used ONLY for query-node user SQL execution (defence-in-depth alongside
# AST validation). When *_READONLY_USER/_PASSWORD are set, frms-coe-lib opens a second pool
# per database that connects as this role (reusing the same HOST/PORT/DATABASE/CERT above).
# Must be granted SELECT on the corresponding database. Omit to disable query-node on that DB.
CONFIGURATION_DATABASE_READONLY_USER='readonly'
CONFIGURATION_DATABASE_READONLY_PASSWORD='password'
EVENT_HISTORY_DATABASE_READONLY_USER='readonly'
EVENT_HISTORY_DATABASE_READONLY_PASSWORD='password'
EVALUATION_DATABASE_READONLY_USER='readonly'
EVALUATION_DATABASE_READONLY_PASSWORD='password'
RAW_HISTORY_DATABASE_READONLY_USER='readonly'
RAW_HISTORY_DATABASE_READONLY_PASSWORD='password'
SIMULATION_DATABASE_READONLY_USER='readonly'
SIMULATION_DATABASE_READONLY_PASSWORD='password'

# REDIS
REDIS_DATABASE=0
REDIS_AUTH=""
REDIS_SERVERS='[{"host":"127.0.0.1", "port":6379}]'
REDIS_IS_CLUSTER=false
DISTRIBUTED_CACHETTL=300
DISTRIBUTED_CACHE_ENABLED=true

# EFRUP
ACTIVE_CONDITIONS_ONLY=false

# AUTH
AUTHENTICATED=false
CERT_PATH_PUBLIC=
CORS_POLICY=demo

# Service Channel
SERVER_URL=nats://localhost:4222
SERVICE_CHANNEL_PRODUCER=service-channel
SERVICE_CHANNEL_CONSUMER=service-channel-ack
SERVICE_CHANNEL_SOURCE_URI_PREFIX=
